// 실제 위치 후보: build.gradle (Spring Boot 3.x / Gradle)
// 목표: 사내 업무관리 시스템에 필요한 의존성 묶음을 채워보세요.

plugins {
    id 'java'
    // TODO 01: Spring Boot 와 Dependency Management 플러그인을 적어보세요.
    id '____' version '3.3.0'
    id '____'
}

group = 'com.example'
version = '0.0.1-SNAPSHOT'

java {
    // TODO 02: TRD 3.1 의 Java 버전을 채우세요.
    sourceCompatibility = JavaVersion.____
}

repositories {
    mavenCentral()
}

dependencies {
    // TODO 03: REST Controller / Tomcat / Jackson 묶음
    implementation 'org.springframework.boot:____'

    // TODO 04: Entity + Repository + Hibernate
    implementation 'org.springframework.boot:____'

    // TODO 05: @Valid, @NotBlank, @Email 활성화용
    implementation 'org.springframework.boot:____'

    // TODO 06: 화면 요구사항(2.7)을 위한 서버 렌더링 템플릿 엔진
    implementation 'org.springframework.boot:____'

    // TODO 07: 로컬/테스트용 인메모리 DB
    runtimeOnly '____:h2'

    // 운영용 DB 드라이버 (학습 단계에서는 주석 처리 가능)
    // runtimeOnly 'com.mysql:mysql-connector-j'

    testImplementation 'org.springframework.boot:spring-boot-starter-test'
}

tasks.named('test') {
    useJUnitPlatform()
}

