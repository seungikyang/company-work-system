// 실제 위치 후보: build.gradle (Spring Boot 3.x / Gradle)
// 목표: 의존성 묶음을 거의 백지에서. 막히면 starter/00-build-config, answers.md 0장.

// 초보자 안내 (00장): Java·Gradle·Spring Boot
// 개념: Java는 업무 규칙을 작성하는 언어, Gradle은 필요한 라이브러리와 빌드 작업을 관리하는 도구, Spring Boot는 서버 설정을 돕는 틀입니다.
// 사용 이유: 매번 웹 서버와 DB 연결 도구를 따로 조립하는 수고를 줄입니다.
// 동작 흐름: Gradle이 의존성을 준비하고, 실행 시 Spring Boot가 application.yml의 설정을 읽습니다. H2는 연습 데이터를 담고 JPA는 객체와 DB를 연결합니다.
// 읽는 순서: 먼저 같은 챕터 Starter의 코드 옆 설명을 읽고, 여기서 검사·호출 순서를 직접 구성하세요.
// 전체 기술 안내: practice/beginner-guide.md (저장소 루트 기준). 이 파일은 학습용 조각입니다.

plugins {
    id 'java'
    // TODO 01: Spring Boot + Dependency Management 플러그인.
    id '____' version '3.3.0'
    id '____'
}

group = 'com.example'
version = '0.0.1-SNAPSHOT'

java {
    // TODO 02: TRD 3.1 Java 버전.
    sourceCompatibility = JavaVersion.____
}

repositories { mavenCentral() }

dependencies {
    // TODO 03: REST/Tomcat/Jackson.
    implementation 'org.springframework.boot:____'
    // TODO 04: Entity/Repository/Hibernate.
    implementation 'org.springframework.boot:____'
    // TODO 05: @Valid/@NotBlank/@Email.
    implementation 'org.springframework.boot:____'
    // TODO 06: 서버 렌더링 템플릿.
    implementation 'org.springframework.boot:____'
    // TODO 07: 로컬/테스트 인메모리 DB.
    runtimeOnly '____:h2'
    // TODO 08: 1차 세션 단계의 BCrypt 해시에 필요한 최소 보안 모듈.
    implementation 'org.springframework.security:____'
    // 2차 SecurityFilterChain/@PreAuthorize 단계에서 추가:
    // implementation 'org.springframework.boot:spring-boot-starter-security'
    // runtimeOnly 'com.mysql:mysql-connector-j'
    testImplementation 'org.springframework.boot:spring-boot-starter-test'
}

tasks.named('test') { useJUnitPlatform() }

// 학습 질문 (직접 답):
// Q1. "스타터" 가 단순 라이브러리와 다른 점은?
//     A:
// Q2. dependency-management 플러그인이 있으면 version 을 생략하는 이유(BOM)?
//     A:
// Q3. javax.* → jakarta.* 변경이 Validation/JPA 코드에 주는 영향?
//     A:
// Q4. security-crypto 와 starter-security 를 단계별로 나누는 이유?
//     A:

// 자가 채점:
// □ org.springframework.boot version, io.spring.dependency-management
// □ JavaVersion.VERSION_17  □ starter-web/data-jpa/validation/thymeleaf  □ com.h2database:h2
// □ spring-security-crypto(1차)  □ starter-security(2차)
