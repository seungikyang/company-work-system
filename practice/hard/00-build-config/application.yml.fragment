# 실제 위치 후보: src/main/resources/application.yml
# 목표: 로컬 학습용 H2 + JPA 설정을 거의 백지에서. 막히면 starter/00-build-config, answers.md 0장.

# 초보자 안내 (00장): Java·Gradle·Spring Boot
# 개념: Java는 업무 규칙을 작성하는 언어, Gradle은 필요한 라이브러리와 빌드 작업을 관리하는 도구, Spring Boot는 서버 설정을 돕는 틀입니다.
# 사용 이유: 매번 웹 서버와 DB 연결 도구를 따로 조립하는 수고를 줄입니다.
# 동작 흐름: Gradle이 의존성을 준비하고, 실행 시 Spring Boot가 application.yml의 설정을 읽습니다. H2는 연습 데이터를 담고 JPA는 객체와 DB를 연결합니다.
# 읽는 순서: 먼저 같은 챕터 Starter의 코드 옆 설명을 읽고, 여기서 검사·호출 순서를 직접 구성하세요.
# 전체 기술 안내: practice/beginner-guide.md (저장소 루트 기준). 이 파일은 학습용 조각입니다.

spring:
  datasource:
    # TODO 01: 인메모리 H2 URL (이름 testdb).
    url: jdbc:h2:mem:____
    driver-class-name: org.h2.Driver
    username: sa
    password:

  h2:
    console:
      # TODO 02: 브라우저 H2 콘솔 접속 허용 값.
      enabled: ____
      path: /h2-console

  jpa:
    hibernate:
      # TODO 03: 로컬은 매 실행 스키마 재생성, 운영은? (create/validate/none 비교)
      ddl-auto: ____
    properties:
      hibernate:
        # TODO 04: SQL 줄바꿈/들여쓰기.
        format_sql: ____
    # TODO 05: 콘솔에 실행 SQL 출력.
    show-sql: ____

app:
  security:
    session-timeout: ${APP_SESSION_TIMEOUT:1800}

